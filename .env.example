# Variables de servired-moderacion (las mismas que pone servired-infra/compose).
# Copia a .env (no se commitea). No hay variables de Supabase Auth: este servicio no valida JWT.

# PostgreSQL (Supabase). Se usan desde M1.
DB_URL=jdbc:postgresql://db.<proyecto>.supabase.co:5432/postgres?sslmode=require
DB_USER=svc_moderacion
DB_PASSWORD=
DB_SCHEMA=moderacion

# RabbitMQ. Se usa desde M3.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Consultas síncronas. Se usan desde M2.
REPORTES_BASE_URL=http://reportes:8081
INDICADORES_BASE_URL=http://indicadores:8083
SYNC_TIMEOUT_MS=2000

# Umbrales de las reglas (propuestos; se usan desde M1 y M2).
# MODERACION_REGLAS_DESCRIPCION_MIN=10
# MODERACION_REGLAS_DISTANCIA_MAX_METROS=2000
# MODERACION_REGLAS_UMBRAL_RECHAZOS=5
